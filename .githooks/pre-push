#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

run_nix_in_snapshot() (
  cd "$nix_check_dir"
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
  unset GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
  "$@"
)

while IFS=' ' read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ -z "$local_sha" || "$local_sha" =~ ^0+$ ]] && continue

  echo "Checking pushed commit $local_ref ($local_sha)"
  nix_check_dir="$(mktemp -d "${TMPDIR:-/tmp}/nix-push-check.XXXXXX")"
  trap 'rm -rf -- "$nix_check_dir"' EXIT

  if ! git archive --format=tar "$local_sha" | tar -xf - -C "$nix_check_dir"; then
    echo "Could not create a snapshot of $local_sha" >&2
    exit 1
  fi

  if ! run_nix_in_snapshot nix fmt -- --check; then
    echo "Nix format check failed. Run 'nix fmt', review and commit the changes, then push again." >&2
    exit 1
  fi

  if ! run_nix_in_snapshot nix flake check --no-build; then
    echo "Nix flake check failed for $local_sha; fix the error and push again." >&2
    exit 1
  fi

  if ! run_nix_in_snapshot nix build .#checks.x86_64-linux.workflows --no-link --print-build-logs; then
    echo "Workflow regression tests failed for $local_sha." >&2
    exit 1
  fi

  rm -rf -- "$nix_check_dir"
  trap - EXIT
done
