# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "nvme"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  # This UUID is specific to this machine. Regenerate this file on the target
  # system when installing on another machine.
  fileSystems."/" = {
    device = "/dev/disk/by-uuid/06d0b498-0000-4d08-a97a-56702a562ed2";
    fsType = "ext4";
  };

  # ESP is nvme0n1p1. Restrict access to owner-only to avoid bootctl warnings.
  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/80B5-4F15";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  # Refer to swap by label so it matches boot.resumeDevice in laptop.nix.
  swapDevices = [
    {
      device = "/dev/disk/by-label/swap";
    }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
